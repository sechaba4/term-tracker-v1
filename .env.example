# Term Tracker — environment variables
# Copy these into Netlify → Site settings → Environment variables.
# DO NOT commit real values. This file only documents the names.

# Supabase (public, browser-safe — protected by Row Level Security)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# NVIDIA AI (server-side only — used by netlify/functions/ai.js, never sent to the browser)
NVIDIA_API_KEY=nvapi-your-key-here
# Optional: override the model (default: meta/llama-3.1-70b-instruct)
# AI_MODEL=meta/llama-3.1-70b-instruct
