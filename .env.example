# Term Tracker — environment variables
# Copy these into Netlify → Site settings → Environment variables.
# DO NOT commit real values. This file only documents the names.

# Supabase (public, browser-safe — protected by Row Level Security)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# NVIDIA AI (server-side only — used by netlify/functions/ai.js, never sent to the browser)
NVIDIA_API_KEY=nvapi-your-key-here
# Optional: override the model. Default is the cheap+fast meta/llama-3.1-8b-instruct.
# For higher-quality marking you could use meta/llama-3.1-70b-instruct (costs more).
# AI_MODEL=meta/llama-3.1-8b-instruct

# Optional: rate limits that protect your NVIDIA key from runaway cost.
# RL_PER_MIN=15     # max AI requests per visitor IP per minute
# RL_GLOBAL_MIN=60  # max AI requests per function instance per minute
